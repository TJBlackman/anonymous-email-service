{{define "content"}}
<section class="panel">
    <h2>Disposable email, with a login</h2>
    <p class="muted">Create an email address to receive mail. You will be given a
    one-time password to log in and read your inbox.</p>
    <div class="summary-actions">
        <a href="/register"><button type="button">Create an email address</button></a>
        <a href="/login"><button type="button">Log in</button></a>
    </div>
</section>
{{end}}
