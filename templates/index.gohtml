{{define "content"}}
<section class="panel inbox-summary">
    <div>
        <p class="section-label">Your address</p>
        <p class="address">{{.Inbox.Address}}</p>
    </div>
    <div class="summary-actions">
        <p><strong>{{.UnreadCount}}</strong> unread</p>
    </div>
</section>

<section class="panel">
    <div class="section-heading">
        <h2>Recent Emails</h2>
        <a href="/app/api/emails">JSON feed</a>
    </div>
    {{if .Emails}}
    <ul class="email-list">
        {{range .Emails}}
        <li class="email-row {{if not .IsRead}}is-unread{{end}}">
            <a href="/app/email/{{.ID}}" class="email-link">
                <span class="email-subject">{{.Subject}}</span>
                <span class="email-sender">{{if .SenderName}}{{.SenderName}} &lt;{{.Sender}}&gt;{{else}}{{.Sender}}{{end}}</span>
                <span class="email-time">{{.ReceivedAt.Format "2006-01-02 15:04:05 MST"}}</span>
            </a>
            {{if .HasAttachments}}<span class="badge">Attachments</span>{{end}}
        </li>
        {{end}}
    </ul>
    {{else}}
    <p class="empty-state">No email has arrived yet. Send a message to this address and refresh.</p>
    {{end}}
</section>
{{end}}
