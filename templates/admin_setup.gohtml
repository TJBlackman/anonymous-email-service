{{define "content"}}
<section class="panel">
    <h2>Set admin password</h2>
    <p>No admin password has been set yet. Choose one now to secure the admin area. This is a one-time step.</p>
    {{if .Error}}
    <p class="empty-state" role="alert">{{.Error}}</p>
    {{end}}
    <form method="post" action="/admin/setup" class="auth-form">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required>

        <label for="confirm_password">Confirm password</label>
        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="12" required>

        <button type="submit">Set password</button>
    </form>
</section>
{{end}}
