{{define "base"}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <main class="shell">
        <header class="hero">
            <div>
                <p class="eyebrow">Anonymous Email Service</p>
                <h1>{{.Title}}</h1>
            </div>
            {{if .Inbox}}
            <div class="hero-meta">
                <p class="meta-label">Inbox</p>
                <p class="meta-value">{{.Inbox.Address}}</p>
            </div>
            {{end}}
        </header>
        {{template "content" .}}
    </main>
</body>
</html>
{{end}}
