{{define "base"}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}}</title>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <main class="shell">
        <header class="hero">
            <p class="eyebrow">Anonymous Email Service</p>
            <h1>{{.Title}}</h1>
        </header>
        {{template "content" .}}
    </main>
</body>
</html>
{{end}}
