{{define "content"}}
<section class="panel">
    <h2>Create an email address</h2>
    <p class="muted">Pick a name for your address and a domain. We generate a
    one-time password for you, shown only once after you create the address.</p>

    {{if .Error}}
    <p class="empty-state" role="alert">{{.Error}}</p>
    {{end}}

    {{if .Domains}}
    <form method="post" action="/register" class="auth-form">
        <label for="local_part">Address name</label>
        <input type="text" id="local_part" name="local_part"
               value="{{.LocalPart}}" required
               pattern="[A-Za-z0-9]+" maxlength="64"
               autocomplete="off" autocapitalize="off" spellcheck="false">
        <label for="domain">Domain</label>
        <select id="domain" name="domain">
            {{range .Domains}}
            <option value="{{.Name}}">{{.Name}}</option>
            {{end}}
        </select>
        <button type="submit">Create address</button>
    </form>
    {{else}}
    <p class="empty-state">No domains are available yet. Please check back later.</p>
    {{end}}

    <p class="muted">Already have an address? <a href="/login">Log in</a>.</p>
</section>
{{end}}
